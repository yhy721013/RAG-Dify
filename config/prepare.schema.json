{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Check Id",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "query": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Query",
          "type": "string"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/Hit"
          },
          "maxItems": 50,
          "title": "Hits",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "observation_ids",
        "query",
        "hits"
      ],
      "title": "Check",
      "type": "object"
    },
    "Hit": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "document_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "segment_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Segment Id",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "dataset_id",
        "document_id",
        "segment_id",
        "score"
      ],
      "title": "Hit",
      "type": "object"
    },
    "ImageRef": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Image Id",
          "type": "string"
        },
        "position": {
          "maximum": 4,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "file_ref": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "File Ref",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "position",
        "file_ref"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Observation Id",
          "type": "string"
        },
        "image_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Image Ids",
          "type": "array"
        },
        "visible_fact": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Visible Fact",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "image_ids",
        "visible_fact"
      ],
      "title": "Observation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "equipment_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Equipment Id",
      "type": "string"
    },
    "image_manifest": {
      "items": {
        "$ref": "#/$defs/ImageRef"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Image Manifest",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "equipment_type": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equipment Type"
    },
    "equipment_description": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equipment Description"
    },
    "user_question": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Question"
    },
    "operating_state": {
      "anyOf": [
        {
          "enum": [
            "运行",
            "停机",
            "检修",
            "未知"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operating State"
    },
    "work_context": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Context"
    },
    "same_equipment_confirmed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Same Equipment Confirmed"
    },
    "workflow_version": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Version"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    }
  },
  "required": [
    "request_id",
    "snapshot_id",
    "equipment_id",
    "image_manifest",
    "observations",
    "checks"
  ],
  "title": "PrepareRequest",
  "type": "object"
}
